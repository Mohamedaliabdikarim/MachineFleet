@inherits LayoutComponentBase

<div class="min-vh-100 d-flex flex-column bg-body-tertiary">

    <header class="sticky-top">
        <NavMenu NavTitle="Industrial Fleet Manager" />
    </header>

    <main class="flex-grow-1">
        <div class="container py-4">
            @Body
        </div>
    </main>

    <footer class="border-top bg-body">
        <div class="container py-3 small text-secondary">
            Industrial Fleet Manager • Blazor
        </div>
    </footer>

</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>