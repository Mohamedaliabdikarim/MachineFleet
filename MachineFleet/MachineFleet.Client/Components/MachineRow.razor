<tr>
    <td class="fw-medium">@Machine.Name</td>
    <td class="small text-secondary font-monospace">@Machine.Id</td>
    <td>
        <span class="badge rounded-pill @(Machine.IsOnline ? "text-bg-success" : "text-bg-danger")">
            @(Machine.IsOnline ? "Online" : "Offline")
        </span>
    </td>
    <td>@Machine.LastData</td>
    <td class="small">@Machine.LastUpdated.ToString("yyyy-MM-dd HH:mm:ss")</td>
    <td class="text-end">
        <div class="btn-group btn-group-sm" role="group">
            <button class="btn btn-outline-success" type="button"
                    disabled="@Machine.IsOnline"
                    @onclick="() => InvokeActionAsync(Actions.OnStart)">
                Start
            </button>

            <button class="btn btn-outline-warning" type="button"
                    disabled="@(!Machine.IsOnline)"
                    @onclick="() => InvokeActionAsync(Actions.OnStop)">
                Stop
            </button>

            <button class="btn btn-outline-primary text-nowrap" type="button"
                    disabled="@(!Machine.IsOnline)"
                    @onclick="() => InvokeActionAsync(Actions.OnSendData)">
                Send Data
            </button>

            <button class="btn btn-outline-danger" type="button"
                    @onclick="() => InvokeActionAsync(Actions.OnDelete)">
                Delete
            </button>
        </div>
    </td>
</tr>

@code {

    [Parameter]
    public Machine Machine { get; set; } = null!;

    [CascadingParameter]
    public MachineActions Actions { get; set; } = null!;

    private async Task InvokeActionAsync(EventCallback<Guid> callback)
    {
        if (callback.HasDelegate)
            await callback.InvokeAsync(Machine.Id);
    }
}